# ---- נדרים פלוס ----
# מספר המוסד (7 ספרות) ומפתח API שנוצר במסך הגדרות > API > מפתחות API
NEDARIM_MOSAD_ID=7654321
NEDARIM_API_PASSWORD=npk_xxxxxxxxxxxxxxxx

# ---- סנכרון ----
SYNC_INTERVAL_HOURS=5
SYNC_ON_BOOT=true

# ---- אתר הניהול ----
ADMIN_USER=nissim
ADMIN_PASSWORD=שנו-אותי
# מחרוזת אקראית ארוכה: openssl rand -hex 32
SESSION_SECRET=

# ---- השלוחה הקולית ----
# מחרוזת סודית שמתווספת לכתובת שמוגדרת בשלוחה: /ivr?token=...
IVR_TOKEN=
STT_SECONDS=7
MAX_ATTEMPTS=3
# קול Gemini בתשלום, למשל Achird. ריק = קול גוגל החינמי
TTS_VOICE=

# ---- ספי התאמה ----
AUTO_THRESHOLD=0.90
CONFIRM_THRESHOLD=0.62

# ---- מערכת ----
PORT=80
DATA_DIR=/app/data
